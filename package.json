{
  "name": "jujutsu",
  "productName": "JJKPPDB Offline",
  "private": true,
  "version": "1.2.2",
  "description": "Jujutsu Kaisen: Phantom Parade Database Offline (Web & Desktop)",
  "author": "Lucas",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "desktop": "npm run build && electron .",
    "pack:win": "electron-builder --win --x64",
    "electron:build": "tsc -b && vite build && electron-builder --win --x64",
    "build:exe": "node scripts/build_exe.cjs",
    "thumbs": "electron scripts/generate_static_thumbs.cjs",
    "sync": "node scripts/sync_new_content.cjs"
  },
  "build": {
    "appId": "com.jjkppdb.offline",
    "productName": "JJKPPDB Offline",
    "publish": {
      "provider": "github",
      "owner": "Jklmkii",
      "repo": "jujutsu-phantom-parade-db"
    },
    "compression": "maximum",
    "directories": {
      "output": "C:/temp/jjk-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "JJKPPDB Offline",
      "artifactName": "JJKPPDB-Offline-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "JJKPPDB-Offline-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.46.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  }
}
